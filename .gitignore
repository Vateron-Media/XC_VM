.vscode/
dist/
.DS_Store
__pycache__/
*.pyc
*.phpunit.result.cache
EXTENSION.md
# Runtime scratch written under src/tmp/ at run/test time (autoload_map, *.log,
# flood/crons/divergence/... caches). Keep the committed directory skeleton via
# the .gitkeep files; ignore everything else so it never lands in `git add -A`.
src/tmp/**
!src/tmp/**/
!src/tmp/**/.gitkeep
tests/.cache/
# Runtime test scratch dir created by tests/bootstrap.php (bin/, vod/, fake_bin)
tests/.tmp/
# PHPUnit coverage report (generated by the CI test job / local coverage runs)
coverage.xml

# NOTE: src/vendor/ is intentionally NOT ignored — the Composer autoloader and
# PRODUCTION dependencies are committed and shipped (the deploy path has no
# Composer). It is committed via `composer install --no-dev`. Dev tools (PHPStan,
# PHP-CS-Fixer) are NOT committed — run `composer install` to get them locally.
# src/composer.lock IS committed (this is an application) so install is reproducible.
.claude/

# Static-analysis / style caches
.phpstan.cache/
.php-cs-fixer.cache
