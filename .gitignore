.vscode/
dist/
.DS_Store
__pycache__/
*.pyc
*.phpunit.result.cache
EXTENSION.md
# Runtime scratch written under src/tmp/ at run/test time (autoload_map, *.log,
# flood/crons/divergence/... caches). Keep the committed directory skeleton via
# the .gitkeep files; ignore everything else so it never lands in `git add -A`.
src/tmp/**
!src/tmp/**/
!src/tmp/**/.gitkeep
tests/.cache/
# Runtime test scratch dir created by tests/bootstrap.php (bin/, vod/, fake_bin)
tests/.tmp/
# PHPUnit coverage report (generated by the CI test job / local coverage runs)
coverage.xml

# src/vendor/ is committed PRODUCTION-ONLY (composer install --no-dev) and shipped
# (the deploy path has no Composer). A local `composer install` (to get PHPStan /
# PHP-CS-Fixer) writes dev packages here — the rules below ignore everything that
# is NOT part of the committed prod set, so dev packages can never be `git add`-ed.
# (gitignore never untracks: the committed prod files stay tracked and updatable.)
# Adding a NEW production dependency? Whitelist its dir with a `!` line here.
src/vendor/*
!src/vendor/autoload.php
!src/vendor/chrisyue/
!src/vendor/composer/
!src/vendor/gemorroj/
!src/vendor/mobiledetect/
!src/vendor/psr/
# composer/ and psr/ hold a MIX of prod + dev packages — re-ignore their dev-only
# parts and whitelist just the prod ones (composer autoloader; psr/simple-cache is
# a prod dependency of mobiledetectlib, while psr/container|event-dispatcher|log
# are pulled only by dev tools).
src/vendor/composer/pcre/
src/vendor/composer/semver/
src/vendor/composer/xdebug-handler/
src/vendor/composer/autoload_files.php
src/vendor/psr/*
!src/vendor/psr/simple-cache/
# composer.lock IS committed (this is an application) so `composer install` is reproducible.

.claude/

# Static-analysis / style caches
.phpstan.cache/
.php-cs-fixer.cache
tools/test-stream-generator/sample.mp4
