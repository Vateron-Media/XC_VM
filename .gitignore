.vscode/
dist/
.DS_Store
__pycache__/
*.pyc
*.phpunit.result.cache
EXTENSION.md
# Runtime scratch written under src/tmp/ at run/test time (autoload_map, *.log,
# flood/crons/divergence/... caches). Keep the committed directory skeleton via
# the .gitkeep files; ignore everything else so it never lands in `git add -A`.
src/tmp/**
!src/tmp/**/
!src/tmp/**/.gitkeep
tests/.cache/
# Runtime test scratch dir created by tests/bootstrap.php (bin/, vod/, fake_bin)
tests/.tmp/
# PHPUnit coverage report (generated by the CI test job / local coverage runs)
coverage.xml

# Static-analysis / style caches
.phpstan.cache/
build/.phpcs-cache
tools/test-stream-generator/sample.mp4
.understand-anything/*
# Docs: MkDocs build output and the translation cache. docs/ru IS committed —
# it is generated from docs/en (tools/docs/translate.py) and refreshed locally
# before a release, so CI only has to build it.
/build/site/
/build/docs-cache/
/build/docs-venv/

# e2e stream-test reports (test_release.sh streamtest)
tools/test-install/out/
tools/test-install/fixtures/
