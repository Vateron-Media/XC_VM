# Git LFS tracking for large binary artifacts.
#
# NOTE: Adding these rules only affects FUTURE commits. Files already in history
# remain regular blobs until a history migration is performed — see
# docs/en/development/git-lfs-migration.md for the one-time migration runbook.

# FFmpeg / ffprobe (all bundled versions)
src/bin/ffmpeg_bin/** filter=lfs diff=lfs merge=lfs -text
# MaxMind databases NOT distributed via the XC_VM_Update release
# (GeoLite2-City/Country are removed and fetched at install time instead).
src/bin/maxmind/GeoIP2-ISP.mmdb filter=lfs diff=lfs merge=lfs -text
src/bin/maxmind/cidr.db filter=lfs diff=lfs merge=lfs -text
# Other large bundled binaries (pending maintainer confirmation — see H4-D).
src/bin/redis/redis-server filter=lfs diff=lfs merge=lfs -text
src/bin/guess filter=lfs diff=lfs merge=lfs -text
src/bin/yt-dlp filter=lfs diff=lfs merge=lfs -text
src/Public/assets/admin/videos/login-bg.mp4 filter=lfs diff=lfs merge=lfs -text
