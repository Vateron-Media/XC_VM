[Unit]
Description=XC_VM support bot (Telegram + Claude)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/xc_vm-support/tools/support-bot
# Read by systemd itself, so .env can stay root-only (chmod 600)
EnvironmentFile=/opt/xc_vm-support/tools/support-bot/.env
ExecStart=/opt/xc_vm-support/tools/support-bot/.venv/bin/python bot.py
Restart=always
RestartSec=10
# Runs as a throwaway user with no rights on the server
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
